# Il server ascolta solo sul PC locale per impostazione predefinita.
HOST=127.0.0.1
PORT=4173
CRM_DATA_DIR=./data

# Facoltativo: se impostato, il CRM richiede questo PIN all'apertura.
# CRM_PIN=imposta-un-pin-locale

# Ollama locale. Il modello può essere scelto anche nelle impostazioni del CRM.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Supabase opzionale. Non inserire mai chiavi reali in GitHub.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UUID dell'utente Supabase proprietario dei record sincronizzati.
SUPABASE_USER_ID=
