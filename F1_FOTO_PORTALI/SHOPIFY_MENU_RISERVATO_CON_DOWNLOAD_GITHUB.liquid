<style>
  #f1-private-launcher,
  #f1-private-modal{
    --f1-black:#070907;
    --f1-dark:#0E120F;
    --f1-dark-2:#151A16;
    --f1-green:#39F28A;
    --f1-green-2:#20CE70;
    --f1-white:#FFFFFF;
    --f1-paper:#F5F4EF;
    --f1-text-dark:#111512;
    --f1-text-gray:#607066;
    --f1-text-light:#AEB7B0;
    --f1-sea:#50C9E8;
  }
  #f1-private-launcher{
    position:fixed;
    right:12px;
    bottom:12px;
    z-index:99998;
    width:13px;
    height:13px;
    border-radius:50%;
    background:var(--f1-green);
    box-shadow:0 0 0 3px rgba(57,242,138,.08);
    opacity:.16;
    cursor:default;
    transition:.2s ease;
  }

  #f1-private-launcher:hover{
    opacity:.38;
    transform:scale(1.08);
  }

  #f1-private-modal[hidden]{
    display:none!important;
  }

  #f1-private-modal{
    position:fixed;
    inset:0;
    z-index:999999;
    display:grid;
    place-items:center;
    padding:18px;
    font-family:Arial,Helvetica,sans-serif;
  }

  #f1-private-modal *{
    box-sizing:border-box;
  }

  .f1-private-backdrop{
    position:absolute;
    inset:0;
    background:rgba(7,9,7,.88);
    backdrop-filter:blur(9px);
  }

  .f1-private-panel{
    position:relative;
    z-index:2;
    width:min(760px,100%);
    max-height:90vh;
    overflow:auto;
    padding:30px;
    border:1px solid rgba(57,242,138,.24);
    border-radius:24px;
    color:var(--f1-white);
    background:
      radial-gradient(circle at top right,rgba(57,242,138,.16),transparent 35%),
      linear-gradient(145deg,var(--f1-black),var(--f1-dark) 65%,var(--f1-dark-2));
    box-shadow:0 30px 90px rgba(7,9,7,.72);
  }

  .f1-private-close{
    position:absolute;
    top:14px;
    right:14px;
    width:38px;
    height:38px;
    border:1px solid rgba(255,255,255,.12);
    border-radius:50%;
    color:var(--f1-white);
    background:rgba(21,26,22,.80);
    font-size:24px;
    line-height:1;
    cursor:pointer;
  }

  .f1-private-kicker{
    margin-bottom:8px;
    color:var(--f1-green);
    font-size:11px;
    font-weight:900;
    letter-spacing:.18em;
  }

  .f1-private-panel h2{
    margin:0 0 8px;
    color:var(--f1-white);
    font-size:clamp(26px,4vw,38px);
    line-height:1.05;
  }

  .f1-private-panel p{
    margin:0 0 24px;
    color:var(--f1-text-light);
    font-size:14px;
  }

  .f1-private-input-row{
    display:grid;
    grid-template-columns:1fr auto;
    gap:8px;
  }

  #f1-private-pin{
    width:100%;
    min-height:52px;
    padding:0 14px;
    border:1px solid rgba(255,255,255,.14);
    border-radius:12px;
    outline:none;
    color:var(--f1-white);
    background:var(--f1-dark-2);
    font-size:16px;
  }

  #f1-private-pin:focus{
    border-color:var(--f1-green);
    box-shadow:0 0 0 4px rgba(57,242,138,.10);
  }

  #f1-private-show{
    min-width:82px;
    border:1px solid rgba(255,255,255,.12);
    border-radius:12px;
    color:var(--f1-white);
    background:var(--f1-dark-2);
    font-weight:800;
    cursor:pointer;
  }

  #f1-private-error{
    min-height:25px;
    padding-top:7px;
    color:#ff8e8e;
    font-size:12px;
    font-weight:800;
  }

  .f1-private-enter{
    width:100%;
    min-height:52px;
    border:0;
    border-radius:12px;
    color:var(--f1-text-dark);
    background:linear-gradient(135deg,var(--f1-green),var(--f1-green-2));
    font-weight:950;
    letter-spacing:.03em;
    cursor:pointer;
  }

  .f1-private-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:12px;
  }

  .f1-private-card{
    min-height:150px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding:14px 10px;
    border:1px solid rgba(255,255,255,.09);
    border-radius:16px;
    color:var(--f1-white);
    background:rgba(21,26,22,.88);
    text-align:center;
    text-decoration:none!important;
    transition:.18s ease;
  }

  .f1-private-card:hover{
    transform:translateY(-3px);
    border-color:rgba(57,242,138,.48);
    background:rgba(57,242,138,.09);
  }


  .f1-private-card--sea:hover{
    border-color:rgba(80,201,232,.58);
    background:rgba(80,201,232,.10);
  }

  .f1-private-card--sea .f1-private-icon{
    background:linear-gradient(135deg,var(--f1-sea),var(--f1-green));
    box-shadow:0 8px 20px rgba(80,201,232,.16);
  }


  .f1-private-card--calls:hover{
    border-color:rgba(57,242,138,.62);
    background:rgba(57,242,138,.12);
  }

  .f1-private-card--calls .f1-private-icon{
    background:linear-gradient(135deg,var(--f1-green),var(--f1-green-2));
    box-shadow:0 8px 20px rgba(57,242,138,.18);
  }

  .f1-private-icon{
    width:39px;
    height:39px;
    display:grid;
    place-items:center;
    border-radius:12px;
    background:linear-gradient(135deg,var(--f1-green),var(--f1-green-2));
    box-shadow:0 8px 20px rgba(57,242,138,.14);
  }

  .f1-private-icon svg{
    width:21px;
    height:21px;
    fill:none;
    stroke:var(--f1-text-dark);
    stroke-width:1.8;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  .f1-private-card strong{
    color:var(--f1-white);
    font-size:12px;
    line-height:1.25;
    font-weight:850;
  }


  .f1-private-card-note{
    color:var(--f1-text-light);
    font-size:11px;
    line-height:1.3;
  }



  .f1-private-card--github:hover{
    border-color:rgba(57,242,138,.72);
    background:rgba(57,242,138,.14);
  }

  .f1-private-card--github .f1-private-icon{
    background:linear-gradient(135deg,var(--f1-green),var(--f1-green-2));
    box-shadow:0 8px 20px rgba(57,242,138,.22);
  }

  .f1-private-download-guide{
    margin-top:18px;
    padding:20px;
    border:1px solid rgba(57,242,138,.20);
    border-radius:16px;
    background:rgba(21,26,22,.72);
  }

  .f1-private-download-kicker{
    margin-bottom:7px;
    color:var(--f1-green);
    font-size:10px;
    font-weight:900;
    letter-spacing:.15em;
  }

  .f1-private-download-guide h3{
    margin:0 0 14px;
    color:var(--f1-white);
    font-size:20px;
    line-height:1.2;
  }

  .f1-private-github-button{
    width:100%;
    min-height:50px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:16px;
    padding:12px 16px;
    border-radius:12px;
    color:var(--f1-text-dark)!important;
    background:linear-gradient(135deg,var(--f1-green),var(--f1-green-2));
    font-size:12px;
    font-weight:950;
    letter-spacing:.03em;
    text-align:center;
    text-decoration:none!important;
    transition:.18s ease;
  }

  .f1-private-github-button:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 24px rgba(57,242,138,.18);
  }

  .f1-private-download-guide ol{
    margin:0;
    padding-left:22px;
    color:var(--f1-text-light);
    font-size:13px;
    line-height:1.55;
  }

  .f1-private-download-guide li{
    margin-bottom:6px;
    padding-left:3px;
  }

  .f1-private-download-guide strong{
    color:var(--f1-white);
  }

  #f1-private-logout{
    width:100%;
    min-height:46px;
    margin-top:18px;
    border:1px solid rgba(255,255,255,.1);
    border-radius:12px;
    color:var(--f1-text-light);
    background:rgba(21,26,22,.72);
    font-size:12px;
    font-weight:850;
    cursor:pointer;
  }

  body.f1-private-open{
    overflow:hidden!important;
  }

  @media(max-width:680px){
    .f1-private-panel{
      padding:25px 16px 18px;
      border-radius:18px;
    }

    .f1-private-grid{
      grid-template-columns:minmax(0,1fr);
    }

    .f1-private-card{
      min-height:100px;
    }
  }
</style>

<script>
(function(){
  const launcher = document.getElementById('f1-private-launcher');
  const modal = document.getElementById('f1-private-modal');
  const login = document.getElementById('f1-private-login');
  const menu = document.getElementById('f1-private-menu');
  const form = document.getElementById('f1-private-form');
  const pin = document.getElementById('f1-private-pin');
  const error = document.getElementById('f1-private-error');
  const show = document.getElementById('f1-private-show');
  const logout = document.getElementById('f1-private-logout');

  if(!launcher || !modal || modal.dataset.ready === '1') return;
  modal.dataset.ready = '1';

  const expectedHash = '741966100568dd49e953c6e42b4228a9c181194a94a17fcee97c99893acbe091';

  let clickCount = 0;
  let clickTimer = null;
  let attempts = 0;
  let lockedUntil = 0;

  function openModal(){
    modal.hidden = false;
    document.body.classList.add('f1-private-open');
    error.textContent = '';
    pin.value = '';

    if(sessionStorage.getItem('f1_private_ok') === '1'){
      login.hidden = true;
      menu.hidden = false;
    }else{
      login.hidden = false;
      menu.hidden = true;
      setTimeout(() => pin.focus(),100);
    }
  }

  function closeModal(){
    modal.hidden = true;
    document.body.classList.remove('f1-private-open');
    error.textContent = '';
    pin.value = '';
  }

  launcher.addEventListener('click',function(){
    clickCount++;
    clearTimeout(clickTimer);

    clickTimer = setTimeout(function(){
      clickCount = 0;
    },2200);

    if(clickCount >= 5){
      clickCount = 0;
      clearTimeout(clickTimer);
      openModal();
    }
  });

  modal.querySelectorAll('[data-f1-close]').forEach(function(el){
    el.addEventListener('click',closeModal);
  });

  show.addEventListener('click',function(){
    const isVisible = pin.type === 'text';
    pin.type = isVisible ? 'password' : 'text';
    show.textContent = isVisible ? 'Mostra' : 'Nascondi';
    pin.focus();
  });

  logout.addEventListener('click',function(){
    sessionStorage.removeItem('f1_private_ok');
    menu.hidden = true;
    login.hidden = false;
    pin.value = '';
    setTimeout(() => pin.focus(),50);
  });

  document.addEventListener('keydown',function(e){
    if(e.key === 'Escape' && !modal.hidden) closeModal();
  });

  async function sha256(value){
    const data = new TextEncoder().encode(value);
    const digest = await crypto.subtle.digest('SHA-256',data);
    return Array.from(new Uint8Array(digest))
      .map(b => b.toString(16).padStart(2,'0'))
      .join('');
  }

  form.addEventListener('submit',async function(e){
    e.preventDefault();

    if(Date.now() < lockedUntil){
      const seconds = Math.ceil((lockedUntil - Date.now()) / 1000);
      error.textContent = 'Accesso bloccato. Riprova tra ' + seconds + ' secondi.';
      return;
    }

    if(!pin.value){
      error.textContent = 'Inserisci il codice.';
      return;
    }

    const hash = await sha256(pin.value);

    if(hash === expectedHash){
      attempts = 0;
      sessionStorage.setItem('f1_private_ok','1');
      login.hidden = true;
      menu.hidden = false;
      return;
    }

    attempts++;
    pin.value = '';
    pin.focus();

    if(attempts >= 5){
      attempts = 0;
      lockedUntil = Date.now() + 60000;
      error.textContent = 'Troppi tentativi. Blocco attivo per 60 secondi.';
    }else{
      error.textContent = 'Codice errato. Tentativo ' + attempts + ' di 5.';
    }
  });
})();
</script>